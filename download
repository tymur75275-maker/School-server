<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Кабінет Вчителя</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar { background: linear-gradient(135deg, #198754, #146c43); box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); }
        .card { border: none; border-radius: 12px; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05); }
        .btn-status-group .btn { font-size: 0.78rem; padding: 4px 8px; font-weight: 600; }
        .btn-status-group .btn-check:checked + .btn-outline-success { background-color: #198754; color: white; }
        .btn-status-group .btn-check:checked + .btn-outline-danger { background-color: #dc3545; color: white; }
        .btn-status-group .btn-check:checked + .btn-outline-primary { background-color: #0d6efd; color: white; }
        .btn-status-group .btn-check:checked + .btn-outline-warning { background-color: #fd7e14; border-color: #fd7e14; color: white; }
        .grade-badge { font-size: 0.9rem; padding: 4px 10px; border-radius: 15px; }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark mb-4 py-3">
        <div class="container">
            <span class="navbar-brand mb-0 h1"><i class="fa-solid fa-chalkboard-user me-2"></i>Кабінет Вчителя</span>
            <a href="{{ url_for('logout') }}" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="fa-solid fa-right-from-bracket me-1"></i> Вийти
            </a>
        </div>
    </nav>

    <div class="container pb-5">
        <!-- Блок створення оцінок -->
        <div class="card p-4 mb-4">
            <form action="{{ url_for('add_grade') }}" method="POST" id="gradesForm">
                
                <!-- Панель фільтру/предмета і кнопка "Додати" в один рядок -->
                <div class="row g-2 align-items-center mb-4">
                    <div class="col-md-5">
                        <select class="form-select" id="subject_id" name="subject_id" required>
                            <option value="" selected disabled>Оберіть предмет...</option>
                            {% for s_id, s_name in subjects %}
                                <option value="{{ s_id }}">{{ s_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center" type="button" id="classFilterDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <span>Фільтр за класами</span>
                            </button>
                            <ul class="dropdown-menu p-2 w-100" aria-labelledby="classFilterDropdown">
                                <li><label class="dropdown-item rounded"><input type="checkbox" class="form-check-input me-2 class-filter" value="all" checked> Усі класи</label></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><label class="dropdown-item rounded"><input type="checkbox" class="form-check-input me-2 class-filter" value="7"> 7 клас</label></li>
                                <li><label class="dropdown-item rounded"><input type="checkbox" class="form-check-input me-2 class-filter" value="8"> 8 клас</label></li>
                                <li><label class="dropdown-item rounded"><input type="checkbox" class="form-check-input me-2 class-filter" value="9"> 9 клас</label></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100 fw-semibold">
                            <i class="fa-solid fa-plus me-1"></i> Додати
                        </button>
                    </div>
                </div>

                <!-- Таблиця заповнення оцінок -->
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 320px;">Статус відвідуваності</th>
                                <th>Ім'я учня</th>
                                <th style="width: 110px;">Оцінка</th>
                                <th>Коментар вчителя</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for student in students %}
                            <!-- Підтримує як кортеж (st_id, st_name, st_class), так і об'єкт/словник -->
                            <tr class="student-row" data-class="{{ student[2] if student|length > 2 else student.class_name|default('') }}">
                                <td>
                                    <input type="hidden" name="student_ids[]" value="{{ student[0] if student is iterable and student is not string else student.id }}">
                                    <!-- 4 кнопки статусів -->
                                    <div class="btn-group btn-status-group w-100" role="group">
                                        {% set st_id = student[0] if student is iterable and student is not string else student.id %}
                                        <input type="radio" class="btn-check status-radio" name="status_{{ st_id }}" id="pres_{{ st_id }}" value="Присутній" checked data-studentid="{{ st_id }}">
                                        <label class="btn btn-outline-success" for="pres_{{ st_id }}">Присутній</label>

                                        <input type="radio" class="btn-check status-radio" name="status_{{ st_id }}" id="abs_{{ st_id }}" value="Не присутній" data-studentid="{{ st_id }}">
                                        <label class="btn btn-outline-danger" for="abs_{{ st_id }}">Відсутній</label>

                                        <input type="radio" class="btn-check status-radio" name="status_{{ st_id }}" id="del_{{ st_id }}" value="Відстрочка" data-studentid="{{ st_id }}">
                                        <label class="btn btn-outline-primary" for="del_{{ st_id }}">Відстрочка</label>

                                        <input type="radio" class="btn-check status-radio" name="status_{{ st_id }}" id="ret_{{ st_id }}" value="Перездача" data-studentid="{{ st_id }}">
                                        <label class="btn btn-outline-warning" for="ret_{{ st_id }}">Перездача</label>
                                    </div>
                                </td>
                                <td class="fw-semibold text-dark">{{ student[1] if student is iterable and student is not string else student.name }}</td>
                                <td>
                                    <input type="number" class="form-control grade-input" id="grade_input_{{ st_id }}" name="grade_{{ st_id }}" min="1" max="12" placeholder="1-12">
                                </td>
                                <td>
                                    <input type="text" class="form-control" name="comment_{{ st_id }}" placeholder="Коментар...">
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </form>
        </div>

        <!-- Журнал виставлених оцінок -->
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark mb-0">Журнал виставлених оцінок</h4>
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Усього: {{ grades|length }}</span>
            </div>

            {% if grades %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Учень</th>
                            <th>Предмет</th>
                            <th class="text-center">Оцінка</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for student, subject, grade in grades %}
                        <tr>
                            <td class="fw-semibold text-dark">{{ student if student else '—' }}</td>
                            <td>{{ subject if subject else '—' }}</td>
                            <td class="text-center">
                                {% if grade %}
                                    <span class="badge bg-success grade-badge">{{ grade }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Блокування/розблокування поля оцінки залежно від статусу відвідуваності
            const statusRadios = document.querySelectorAll('.status-radio');

            function toggleGradeInput(radio) {
                const stId = radio.dataset.studentid;
                const gradeInput = document.getElementById(`grade_input_${stId}`);
                
                if (!gradeInput) return;

                if (radio.value === 'Не присутній') {
                    gradeInput.value = '';
                    gradeInput.disabled = true;
                    gradeInput.classList.remove('is-invalid');
                } else {
                    gradeInput.disabled = false;
                }
            }

            statusRadios.forEach(radio => {
                if (radio.checked) {
                    toggleGradeInput(radio);
                }

                radio.addEventListener('change', function() {
                    toggleGradeInput(this);
                });
            });

            // 2. Фільтрація рядків таблиці за класами
            const classFilters = document.querySelectorAll('.class-filter');
            const studentRows = document.querySelectorAll('.student-row');

            function filterStudents() {
                const allCheckbox = document.querySelector('.class-filter[value="all"]');
                const selectedClasses = Array.from(classFilters)
                    .filter(cb => cb.checked && cb.value !== 'all')
                    .map(cb => cb.value);

                studentRows.forEach(row => {
                    const studentClass = String(row.dataset.class || '').trim();
                    if (allCheckbox.checked || selectedClasses.length === 0 || selectedClasses.includes(studentClass)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            classFilters.forEach(filter => {
                filter.addEventListener('change', function() {
                    const allCheckbox = document.querySelector('.class-filter[value="all"]');
                    
                    if (this.value === 'all' && this.checked) {
                        classFilters.forEach(cb => { if (cb.value !== 'all') cb.checked = false; });
                    } else if (this.value !== 'all' && this.checked) {
                        allCheckbox.checked = false;
                    }

                    // Якщо всі інші зняті — повертаємо "Усі класи"
                    const anyChecked = Array.from(classFilters).some(cb => cb.checked);
                    if (!anyChecked) {
                        allCheckbox.checked = true;
                    }

                    filterStudents();
                });
            });

            // 3. Валідація перед відправкою форми
            document.getElementById('gradesForm').addEventListener('submit', function(e) {
                const studentIds = document.querySelectorAll('input[name="student_ids[]"]');
                let hasError = false;

                studentIds.forEach(input => {
                    const stId = input.value;
                    const statusRadio = document.querySelector(`input[name="status_${stId}"]:checked`);
                    const gradeInput = document.getElementById(`grade_input_${stId}`);
                    const row = input.closest('tr');

                    // Перевіряємо тільки видимі рядки
                    if (row && row.style.display !== 'none') {
                        if (statusRadio && statusRadio.value === 'Присутній') {
                            if (!gradeInput.value.trim()) {
                                gradeInput.classList.add('is-invalid');
                                hasError = true;
                            } else {
                                gradeInput.classList.remove('is-invalid');
                            }
                        } else {
                            gradeInput.classList.remove('is-invalid');
                        }
                    }
                });

                if (hasError) {
                    e.preventDefault();
                    alert("Будь ласка, заповніть оцінки для всіх присутніх учнів!");
                }
            });
        });
    </script>
</body>
</html>
